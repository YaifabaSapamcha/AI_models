# Server
HOST=0.0.0.0
PORT=8080

# Dell Inspiron 15 3511 / integrated webcam defaults
CAMERA_INDEX=0
WIDTH=640
HEIGHT=480
FPS=10
JPEG_QUALITY=70

# Detection is off by default so the webcam stream starts smoothly on CPU-only laptops.
# Enable it from the dashboard or set DETECTION_ENABLED=true.
DETECTION_ENABLED=false
DETECTION_MODEL=yolov5n
CONFIDENCE_THRESHOLD=0.50
DETECTION_SIZE=320
# Run detection every Nth camera frame; higher values reduce CPU use.
DETECTION_INTERVAL=3
# Keep this at 1-2 on an Intel laptop to leave CPU available for the browser.
TORCH_THREADS=2
